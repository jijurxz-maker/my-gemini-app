const express = require('express');
const cors = require('cors');
const { GoogleGenAI } = require('@google/generative-ai');

const app = express();
app.use(cors());
app.use(express.json());

// Initialize the Gemini API client safely using environment variables
const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });

// Basic testing endpoint to check if server is working in browser
app.get('/', (req, res) => {
    res.send('Gemini backend server is running perfectly!');
});

// Primary POST endpoint for chat requests
app.post('/api/chat', async (req, res) => {
    try {
        const { message } = req.body;
        
        if (!message) {
            return res.status(400).json({ error: 'Message content is required' });
        }

        const response = await ai.models.generateContent({
            model: 'gemini-2.5-flash',
            contents: message,
        });

        res.json({ reply: response.text });
    } catch (error) {
        console.error('Server Error:', error);
        res.status(500).json({ error: error.message });
    }
});

// Dynamic port configuration needed for direct Render hosting compatibility
const PORT = process.env.PORT || 10000;
app.listen(PORT, () => {
    console.log(`Server successfully listening on port ${PORT}`);
});
